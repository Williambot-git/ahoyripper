# ─── AhoyRipper Configuration ────────────────────────────────────────────────

# yt-dlp version to install in the Docker image.
# Defaults to 'latest' — automatically uses the newest release on each build.
# Pin to a specific version (e.g. '2024.08.06') for reproducible builds.
# When pinned, the Docker build verifies the SHA256 checksum and validates
# the installed version matches the expected version.
# Docker: YTDLP_VERSION=2024.08.06
YTDLP_VERSION=latest

# API key for unlimited usage (bypasses daily quota).
# In production this MUST be set via an environment variable, not stored in code.
# Docker: AHOY_UNLIMITED_KEY=your-secret-key-here
AHOY_UNLIMITED_KEY=

# Custom User-Agent string sent with yt-dlp requests.
# Defaults to a standard Chrome/Windows UA if not set.
# Useful for debugging or when a site blocks the default UA.
# Docker: AHOY_USER_AGENT="Mozilla/5.0 ..."
AHOY_USER_AGENT=

# yt-dlp 2024.09+ browser TLS fingerprint impersonation target.
# Passed as --impersonate to yt-dlp to spoof browser TLS/ALPN fingerprints,
# dramatically reducing 403/422 bot-detection errors on protected sites.
# Set to empty to disable impersonation (yt-dlp will still use AHOY_USER_AGENT).
# Docker: AHOY_IMPERSONATE=chrome
AHOY_IMPERSONATE=chrome

# ─── Optional: Cookies for Authenticated Rips ─────────────────────────────────
# Path to a Netscape-format cookies.txt file for accessing age-restricted or
# login-gated content (YouTube age-restricted videos, Spotify, etc.).
# Mount the file into the container and set the path here.
# See README.md "Passing cookies to yt-dlp" for full instructions.
# COOKIES_PATH=/var/www/ahoyripper/cookies.txt

# ─── Optional: Binary Path Overrides ──────────────────────────────────────────
# Override the paths to yt-dlp and ffprobe binaries.
# Defaults are /usr/local/bin/yt-dlp and /usr/bin/ffprobe.
# Docker: YTDLP_PATH=/usr/local/bin/yt-dlp
# Docker: FFPROBE_PATH=/usr/bin/ffprobe
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFPROBE_PATH=/usr/bin/ffprobe

# ─── Optional: Probe and Verification Timeouts ───────────────────────────────
# Timeout for ffprobe post-download verification (default: 10 seconds).
# ffprobe probing large files on slow storage may need more time.
# Docker: FFPROBE_TIMEOUT=20
FFPROBE_TIMEOUT=10

# Timeout for the health probe (action=health&probe=1, default: 15 seconds).
# The probe is a lightweight --dump-json fetch on a short video, so 15s is plenty.
# Docker: HEALTH_PROBE_TIMEOUT=20
# HEALTH_PROBE_TIMEOUT=15

# YouTube video ID used for the health probe (default: dQw4w9WgXcQ - Rick Astley).
# Any stable, publicly accessible YouTube video ID works. Change this if the default
# is ever geo-restricted or unavailable in your region.
# Docker: HEALTH_PROBE_VIDEO_ID=dQw4w9WgXcQ
# HEALTH_PROBE_VIDEO_ID=dQw4w9WgXcQ

# ─── Optional: Timeout Overrides ──────────────────────────────────────────────
# Timeout for the info action (metadata fetch, default: 45 seconds).
# The PHP-side timeout fires before yt-dlp's own socket timeout, ensuring
# clean error classification (SOURCE_TIMEOUT) rather than unclassified exits.
# Docker: YTDLP_TIMEOUT=60
YTDLP_TIMEOUT=45

# Timeout for the download action (file download, default: 300 seconds / 5 minutes).
# Downloads are I/O-bound and need a longer timeout than the info action.
# Docker: YTDLP_DOWNLOAD_TIMEOUT=600
YTDLP_DOWNLOAD_TIMEOUT=300

# ─── Optional: Rate Limit Overrides ───────────────────────────────────────────
# Override the per-IP rate limit for the info action (default: 30 requests/min).
# The info action is used most frequently; tuning this protects the server against
# API abuse while allowing burst access patterns.
# Docker: RATE_LIMIT=60
# RATE_LIMIT=30

# Override the download rate limit (default: 10 download requests per minute per IP).
# DL_RATE_LIMIT is the maximum number of concurrent/rapid download requests an IP
# can make before being throttled. This is distinct from the daily free quota.
# Docker: DL_RATE_LIMIT=20
DL_RATE_LIMIT=10

# Override the daily request quota (default: 5 for unauthenticated users).
# Unauthenticated users always use this limit. Unlimited-key holders bypass it.
# Set to an integer >= 1. AHOY_UNLIMITED_KEY=... bypasses this entirely.
# Docker: QUOTA_DAILY=50
QUOTA_DAILY=5

# Git
.git
.gitignore
.gitattributes

# Development artifacts — not needed in the final image
tests/
scripts/
deploy/

# Documentation — not needed in the image
README.md
LICENSE

# Docker files — only docker-compose.yml is needed at runtime (for env var reference).
# Dockerfile, .dockerignore are build-time only and should not be copied into the image.
Dockerfile
.dockerignore

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Exception: public/.well-known/ must be copied into the image — it serves
# security.txt (RFC 9116) at /.well-known/security.txt. Security scanners
# (GitHub, OpenBugBounty) and browsers expect to find it at the runtime path.
# Add it before the catch-all so the specific path takes priority.
!.well-known/
!.well-known/security.txt

# Hidden files (catch-all for any remaining dotdirs)
.*/